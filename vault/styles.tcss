$primary: #B2DFDB;
$accent: #B2DFDB;

Screen { background: #101820; color: #e2e8f0; padding: 2 4; }
Screen.narrow { padding: 1; }
Screen.short { padding-top: 0; padding-bottom: 0; }
Input { width: 48; max-width: 100%; }
Input:focus, Button:focus, Checkbox:focus { border: heavy #B2DFDB; }
Button { min-width: 11; width: 11; margin: 0 1 0 0; }
.title { height: 3; text-style: bold; color: #B2DFDB; }
#logo-header { dock: top; height: 4; align-horizontal: right; }
#lock-icon { width: 17; height: 4; text-align: left; color: #B2DFDB; }
#login-form { height: 1fr; align-vertical: middle; }
#login-title { height: 1; margin-bottom: 1; }
#visible { margin-top: 1; margin-bottom: 1; max-width: 100%; }
#status { height: auto; color: #f0c878; }
#hint { dock: bottom; height: auto; color: #9aaebd; }
#accounts-header { height: 4; align-vertical: middle; }
#accounts-header #lock-icon { width: 17; margin-right: 2; }
#search { width: 1fr; min-width: 0; margin: 1 2 0 0; }
#accounts-header #add { margin: 1 0 0 0; }
#accounts-actions { width: auto; height: 4; }
#lock-timer { width: 12; min-width: 12; height: 3; margin: 1 0 0 1; padding: 0; border: none; background: transparent; color: #9aaebd; content-align: center middle; }
#lock-timer:focus { color: #B2DFDB; }
Screen.narrow #accounts-header { layout: grid; grid-size: 1; grid-columns: 1fr; grid-rows: 4 3 3; height: 10; }
Screen.narrow #search { width: 100%; margin: 0; }
Screen.narrow #accounts-header #add { margin: 0; }
Screen.narrow #accounts-actions { height: 3; }
Screen.narrow #lock-timer { margin-top: 0; }
LockIntervalScreen, ClearDataScreen { align: center middle; background: #101820 65%; padding: 0 1; }
#interval-dialog, #clear-modal { width: 40; max-width: 100%; height: auto; max-height: 100%; overflow-y: auto; padding: 1 2; border: round #B2DFDB; background: #101820; }
#interval-title, #clear-title { height: auto; margin-bottom: 1; color: #B2DFDB; text-style: bold; }
#interval-title { height: 1; }
#interval-dialog Button { width: 100%; min-width: 0; height: 1; min-height: 1; border: none; padding: 0 1; margin: 0; text-align: left; }
#interval-dialog Button:focus { background: #B2DFDB; color: #101820; text-style: bold; }
#interval-status { height: auto; color: #f0c878; }
#interval-hint, #clear-hint { height: auto; margin-top: 1; color: #9aaebd; }
#add { background: #00695C; height: 3; min-height: 3; border: none; border-top: tall #00695C; border-bottom: tall #00695C; padding: 0 1; content-align: center middle; }
#add:focus { background: #B2DFDB; color: #101820; border: none; border-top: tall #B2DFDB; border-bottom: tall #B2DFDB; text-style: bold; }
#accounts { height: 1fr; margin-top: 1; }
.account { height: 3; }
.email { width: 1fr; padding-top: 1; }
.account Button { width: 12; }
.account .show-email { width: 6; min-width: 6; }
Screen.narrow .account { layout: grid; grid-size: 3; grid-columns: 1fr 6 8; grid-rows: auto 3; height: auto; }
Screen.narrow .email { column-span: 3; height: auto; padding-top: 0; }
Screen.narrow .account Button { width: 100%; min-width: 0; }
#add-actions { height: 3; margin-top: 1; }
#save { background: #00695C; }
#save:focus { border: heavy #00695C; }
Screen.short #visible { margin-top: 1; margin-bottom: 0; }
Screen.short #login-title { margin-bottom: 0; }
Screen.short #status { margin-top: 0; }

Button.-primary { background: #B2DFDB; color: #ffffff; }
Button.-primary:hover { background: #C2185B; }
#login-title { color: #B2DFDB; }
LoginScreen Input, LoginScreen Checkbox { margin-left: 0; margin-right: 0; padding: 0 1; }
#unlock { width: 17; max-width: 100%; background: #29B6F6; color: #ffffff; }
#unlock:hover { background: #009688; }
#unlock:focus { border: heavy #29B6F6; }
#login-actions { height: 3; }
#clear-data, .account .delete-account, .account .delete-account:focus { width: 8; min-width: 8; height: 3; min-height: 3; padding: 0; border: none; content-align: center middle; text-align: center; color: #E53935; background: transparent; }
.account .delete-account, .account .delete-account:focus { margin: 0; }
#clear-data:hover, #clear-data:focus, .account .delete-account:hover, .account .delete-account:focus { background: #352027; }
#clear-dialog, #add-form { height: 1fr; align-vertical: middle; }
#clear-actions { height: 3; margin-top: 1; }
#clear-actions Button { width: 12; min-width: 12; content-align: center middle; text-align: center; }
ClearDataScreen #clear-actions Button { width: 1fr; min-width: 0; }
#confirm-clear { background: #E53935; color: #ffffff; }
#confirm-clear:focus { border: heavy #E53935; }
